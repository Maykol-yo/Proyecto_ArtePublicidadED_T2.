  DTS:LocaleID="10250"
  DTS:ObjectName="02_Load_Dimensions"
  DTS:PackageType="5"
  DTS:VersionBuild="6"
  DTS:VersionGUID="{69A1D99E-B0B0-4BD8-B4F8-AE04D10138A6}">
  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\SQL_Cargar_DimCliente"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{9E36A18E-DF8B-46A6-B4A1-E5509D6BE0EA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Cargar_DimCliente"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{3E6B5973-4E9D-42AC-8E22-B4481F0AC714}"
          SQLTask:SqlStatementSource="&#xA;-- SSIS: cargar dimensión de clientes&#xA;-- No elimina clientes ni modifica FactVentas.&#xA;&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;IF DB_NAME() &lt;&gt; N'DW_ArtePublicidadED'&#xA;    THROW 51001, 'Base de datos incorrecta.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM stg.LineasPedido_SSIS)&#xA;    THROW 51002, 'La tabla staging esta vacia.', 1;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM stg.LineasPedido_SSIS&#xA;    WHERE ClienteID IS NULL&#xA;       OR NombreCliente IS NULL&#xA;       OR TipoCliente IS NULL&#xA;)&#xA;    THROW 51003, 'Existen clientes con datos obligatorios nulos.', 1;&#xA;&#xA;-- Preparar clientes sin repetir registros idénticos.&#xA;SELECT DISTINCT&#xA;    ClienteID,&#xA;    NombreCliente,&#xA;    TipoCliente&#xA;INTO #ClientesOrigen&#xA;FROM stg.LineasPedido_SSIS;&#xA;&#xA;-- Un mismo cliente no debe tener datos contradictorios.&#xA;IF EXISTS (&#xA;    SELECT ClienteID&#xA;    FROM #ClientesOrigen&#xA;    GROUP BY ClienteID&#xA;    HAVING COUNT(*) &gt; 1&#xA;)&#xA;    THROW 51004, 'Hay datos contradictorios para un cliente.', 1;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    -- Actualizar los datos que cambiaron (SCD tipo 1).&#xA;    UPDATE d&#xA;    SET d.NombreCliente = o.NombreCliente,&#xA;        d.TipoCliente = o.TipoCliente&#xA;    FROM dbo.DimCliente AS d&#xA;    INNER JOIN #ClientesOrigen AS o&#xA;        ON d.ClienteID = o.ClienteID&#xA;    WHERE d.NombreCliente &lt;&gt; o.NombreCliente&#xA;       OR d.TipoCliente &lt;&gt; o.TipoCliente;&#xA;&#xA;    -- Insertar únicamente clientes nuevos.&#xA;    INSERT INTO dbo.DimCliente&#xA;        (ClienteID, NombreCliente, TipoCliente)&#xA;    SELECT&#xA;        o.ClienteID,&#xA;        o.NombreCliente,&#xA;        o.TipoCliente&#xA;    FROM #ClientesOrigen AS o&#xA;    WHERE NOT EXISTS (&#xA;        SELECT 1&#xA;        FROM dbo.DimCliente AS d WITH (UPDLOCK, HOLDLOCK)&#xA;        WHERE d.ClienteID = o.ClienteID&#xA;    );&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;    THROW;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Cargar_DimEmpleado"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{4FCDBB06-158D-4C48-A1FD-71E47FF1F177}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Cargar_DimEmpleado"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{3E6B5973-4E9D-42AC-8E22-B4481F0AC714}"
          SQLTask:SqlStatementSource="&#xA;-- CARGA DIMEMPLEADO - SSIS&#xA;-- Proyecto Arte y Publicidad E&amp;D&#xA;&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;IF DB_NAME() &lt;&gt; N'DW_ArtePublicidadED'&#xA;    THROW 51020, 'Base de datos incorrecta.', 1;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1 FROM stg.LineasPedido_SSIS&#xA;)&#xA;    THROW 51021, 'La tabla staging esta vacia.', 1;&#xA;&#xA;-- Validar datos obligatorios&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM stg.LineasPedido_SSIS&#xA;    WHERE EmpleadoID IS NULL&#xA;       OR NombreEmpleado IS NULL&#xA;       OR Cargo IS NULL&#xA;)&#xA;    THROW 51022, 'Existen empleados con datos nulos.', 1;&#xA;&#xA;-- Obtener empleados distintos&#xA;SELECT DISTINCT&#xA;    EmpleadoID,&#xA;    NombreEmpleado,&#xA;    Cargo&#xA;INTO #EmpleadosOrigen&#xA;FROM stg.LineasPedido_SSIS;&#xA;&#xA;-- Verificar datos contradictorios&#xA;IF EXISTS (&#xA;    SELECT EmpleadoID&#xA;    FROM #EmpleadosOrigen&#xA;    GROUP BY EmpleadoID&#xA;    HAVING COUNT(*) &gt; 1&#xA;)&#xA;    THROW 51023, 'Existen datos contradictorios de empleados.', 1;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    -- Actualizar empleados existentes (SCD tipo 1)&#xA;    UPDATE d&#xA;    SET&#xA;        d.NombreEmpleado = e.NombreEmpleado,&#xA;        d.Cargo = e.Cargo&#xA;    FROM dbo.DimEmpleado AS d&#xA;    INNER JOIN #EmpleadosOrigen AS e&#xA;        ON d.EmpleadoID = e.EmpleadoID&#xA;    WHERE d.NombreEmpleado &lt;&gt; e.NombreEmpleado&#xA;       OR d.Cargo &lt;&gt; e.Cargo;&#xA;&#xA;    -- Insertar únicamente empleados nuevos&#xA;    INSERT INTO dbo.DimEmpleado&#xA;    (&#xA;        EmpleadoID,&#xA;        NombreEmpleado,&#xA;        Cargo&#xA;    )&#xA;    SELECT&#xA;        e.EmpleadoID,&#xA;        e.NombreEmpleado,&#xA;        e.Cargo&#xA;    FROM #EmpleadosOrigen AS e&#xA;    WHERE NOT EXISTS (&#xA;        SELECT 1&#xA;        FROM dbo.DimEmpleado AS d WITH (UPDLOCK, HOLDLOCK)&#xA;        WHERE d.EmpleadoID = e.EmpleadoID&#xA;    );&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Cargar_DimFecha"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{6CA67DF9-B6CA-4C1C-9B9A-0CE91AE480DA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Cargar_DimFecha"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{3E6B5973-4E9D-42AC-8E22-B4481F0AC714}"
          SQLTask:SqlStatementSource="&#xA;-- CARGAR DIMFECHA DESDE SSIS&#xA;&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;IF DB_NAME() &lt;&gt; N'DW_ArtePublicidadED'&#xA;    THROW 51030, 'Base de datos incorrecta.', 1;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1 FROM stg.LineasPedido_SSIS&#xA;)&#xA;    THROW 51031, 'La tabla staging esta vacia.', 1;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM stg.LineasPedido_SSIS&#xA;    WHERE FechaPedido IS NULL&#xA;)&#xA;    THROW 51032, 'Existen fechas nulas.', 1;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    INSERT INTO dbo.DimFecha&#xA;    (&#xA;        FechaKey,&#xA;        FechaCompleta,&#xA;        Dia,&#xA;        Mes,&#xA;        Trimestre,&#xA;        Anio&#xA;    )&#xA;    SELECT&#xA;        CONVERT(INT,&#xA;            CONVERT(CHAR(8), s.FechaPedido, 112)),&#xA;        s.FechaPedido,&#xA;        DAY(s.FechaPedido),&#xA;        MONTH(s.FechaPedido),&#xA;        DATEPART(QUARTER, s.FechaPedido),&#xA;        YEAR(s.FechaPedido)&#xA;    FROM (&#xA;        SELECT DISTINCT FechaPedido&#xA;        FROM stg.LineasPedido_SSIS&#xA;    ) AS s&#xA;    WHERE NOT EXISTS (&#xA;        SELECT 1&#xA;        FROM dbo.DimFecha AS d WITH (UPDLOCK, HOLDLOCK)&#xA;        WHERE d.FechaCompleta = s.FechaPedido&#xA;    );&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;    THROW;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Cargar_DimServicio"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{D3C9E32F-8D0A-47EF-83A5-06EF76E44A09}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Cargar_DimServicio"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{3E6B5973-4E9D-42AC-8E22-B4481F0AC714}"
          SQLTask:SqlStatementSource="&#xA;-- CARGA DE DIMENSION SERVICIO - SSIS&#xA;-- Arte y Publicidad E&amp;D&#xA;&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;IF DB_NAME() &lt;&gt; N'DW_ArtePublicidadED'&#xA;    THROW 51010, 'Base de datos incorrecta.', 1;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1 FROM stg.LineasPedido_SSIS&#xA;)&#xA;    THROW 51011, 'La tabla staging esta vacia.', 1;&#xA;&#xA;-- Validar datos obligatorios&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM stg.LineasPedido_SSIS&#xA;    WHERE ServicioID IS NULL&#xA;       OR NombreServicio IS NULL&#xA;       OR CategoriaID IS NULL&#xA;       OR NombreCategoria IS NULL&#xA;)&#xA;    THROW 51012, 'Existen servicios con datos nulos.', 1;&#xA;&#xA;-- Obtener servicios distintos&#xA;SELECT DISTINCT&#xA;    ServicioID,&#xA;    NombreServicio,&#xA;    CategoriaID,&#xA;    NombreCategoria&#xA;INTO #ServiciosOrigen&#xA;FROM stg.LineasPedido_SSIS;&#xA;&#xA;-- Comprobar datos contradictorios&#xA;IF EXISTS (&#xA;    SELECT ServicioID&#xA;    FROM #ServiciosOrigen&#xA;    GROUP BY ServicioID&#xA;    HAVING COUNT(*) &gt; 1&#xA;)&#xA;    THROW 51013, 'Existen datos contradictorios de servicios.', 1;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    -- Actualizar servicios existentes (SCD tipo 1)&#xA;    UPDATE d&#xA;    SET&#xA;        d.NombreServicio = s.NombreServicio,&#xA;        d.CategoriaID = s.CategoriaID,&#xA;        d.NombreCategoria = s.NombreCategoria&#xA;    FROM dbo.DimServicio d&#xA;    INNER JOIN #ServiciosOrigen s&#xA;        ON d.ServicioID = s.ServicioID&#xA;    WHERE d.NombreServicio &lt;&gt; s.NombreServicio&#xA;       OR d.CategoriaID &lt;&gt; s.CategoriaID&#xA;       OR d.NombreCategoria &lt;&gt; s.NombreCategoria;&#xA;&#xA;    -- Insertar servicios nuevos&#xA;    INSERT INTO dbo.DimServicio&#xA;    (&#xA;        ServicioID,&#xA;        NombreServicio,&#xA;        CategoriaID,&#xA;        NombreCategoria&#xA;    )&#xA;    SELECT&#xA;        s.ServicioID,&#xA;        s.NombreServicio,&#xA;        s.CategoriaID,&#xA;        s.NombreCategoria&#xA;    FROM #ServiciosOrigen s&#xA;    WHERE NOT EXISTS (&#xA;        SELECT 1&#xA;        FROM dbo.DimServicio d WITH (UPDLOCK, HOLDLOCK)&#xA;        WHERE d.ServicioID = s.ServicioID&#xA;    );&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
